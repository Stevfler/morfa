{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morfa",
  "version": "../package.json",
  "identifier": "app.morfa.files",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Morfa",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:* http://localhost:*",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Morfa",
    "category": "Utility",
    "shortDescription": "A fast, modern file manager",
    "longDescription": "Morfa is a fast, modern desktop file manager.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libvips-tools"
        ],
        "recommends": [
          "libreoffice-writer",
          "libreoffice-calc",
          "libreoffice-impress",
          "ffmpeg"
        ]
      },
      "rpm": {
        "depends": [
          "vips-tools"
        ],
        "recommends": [
          "libreoffice-writer",
          "libreoffice-calc",
          "libreoffice-impress",
          "ffmpeg-free"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MzUzOEZCODRFRERENjEKUldSaDNlMkUremcxUjFZaU03VWd2UE5ibys2MDk5MS8rQS9BUm4wN3NYUUJubmxyMG5DMlFEYXEK",
      "endpoints": [
        "https://github.com/Stevfler/morfa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
